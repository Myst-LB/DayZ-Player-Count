# --- Where to get the player count (set one or both) ---
SERVER_HOST=123.45.67.89
SERVER_QUERY_PORT=27016          # Steam query port, NOT the game port (2302)
BATTLEMETRICS_ID=                # fallback if direct query fails, e.g. 12345678

# --- Option A: rename a voice channel (needs a bot) ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
CHANNEL_NAME_ONLINE=🟢 Online: {players}/{max}
CHANNEL_NAME_OFFLINE=🔴 Server Offline

# --- Option B: live-updating embed message (webhook only, no bot) ---
DISCORD_WEBHOOK_URL=
DISCORD_MESSAGE_ID=              # filled in after the one-time create-message step
EMBED_TITLE=

# --- Vercel only: protects /api/update ---
UPDATE_SECRET=change-me-to-something-long
